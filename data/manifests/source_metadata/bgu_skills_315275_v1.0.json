ps://ror.org/05tkyf982"},"authorAffiliationDepartment":{"typeName":"authorAffiliationDepartment","multiple":false,"typeClass":"primitive","value":"Department of Biomedical Engineering and the Zelman Center for Brain Science Research"},"authorAffiliation2":{"typeName":"authorAffiliation2","multiple":false,"typeClass":"primitive","value":"Max Planck Institute for Intelligent Systems"},"authorAffiliation2Id":{"typeName":"authorAffiliation2Id","multiple":false,"typeClass":"primitive","value":"https://ror.org/04fq9j139"},"authorAffiliation2Department":{"typeName":"authorAffiliation2Department","multiple":false,"typeClass":"primitive","value":"Haptic Intelligence Department"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Alex Geftler"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Soroka Medical Center"},"authorAffiliationId":{"typeName":"authorAffiliationId","multiple":false,"typeClass":"primitive","value":"https://ror.org/003sphj24"},"authorAffiliationDepartment":{"typeName":"authorAffiliationDepartment","multiple":false,"typeClass":"primitive","value":"Department of Orthopedic Surgery"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Kossowsky Lev, Hanna"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0002-5058-2382"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Ben-Gurion University of the Negev"},"authorAffiliationId":{"typeName":"authorAffiliationId","multiple":false,"typeClass":"primitive","value":"https://ror.org/05tkyf982"},"authorAffiliationDepartment":{"typeName":"authorAffiliationDepartment","multiple":false,"typeClass":"primitive","value":"Department of Biomedical Engineering and Zelman Center for Brain Science Research, Ben-Gurion University of the Negev"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Nisky, Ilana"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0003-4128-9771"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Ben-Gurion University of the Negev"},"authorAffiliationId":{"typeName":"authorAffiliationId","multiple":false,"typeClass":"primitive","value":"https://ror.org/05tkyf982"},"authorAffiliationDepartment":{"typeName":"authorAffiliationDepartment","multiple":false,"typeClass":"primitive","value":"Department of Biomedical Engineering and Zelman Center for Brain Science Research, Ben-Gurion University of the Negev"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<p><strong>BGU-SKILLS</strong> is a comprehensive dataset of long-term surgical training collected using the da Vinci Research Kit (dVRK), featuring synchronized kinematic and video data. \nThe dataset comprises recordings from 18 surgical residents who, once per month over a six-month period, performed three standardized robot-assisted surgical tasks—Ring Tower Transfer, Knot-Tying, and Suturing—before, during, and after a 26-hour hospital shift. It is designed to support research in surgical robotics, motor learning, and skill assessment by capturing the progression of surgical expertise over time.</p>\n\n<p>For each session, the dataset provides kinematic data, video recordings, manual annotations, and questionnaire-based activity and sleep information.<br>\nA detailed PDF file describes the dataset structure, and data are organized by task-specific folders.</p>\n\n<p>For further details, please refer to the associated publication.<br>\nFor any questions or additional information, please contact <em>Yarden Sharon</em> (shayar@post.bgu.ac.il).</p>\n\n<p>We recommend using the \"Tree\" view to explore the data by folder.</p>"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Sharon, Yarden"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2025-06-18"},{"typeName":"publication","multiple":true,"typeClass":"compound","value":[{"publicationCitation":{"typeName":"publicationCitation","multiple":false,"typeClass":"primitive","value":"Dataset and Analysis of Long-Term Skill Acquisition in Robot-Assisted Minimally Invasive Surgery"},"publicationURL":{"typeName":"publicationURL","multiple":false,"typeClass":"primitive","value":"https://arxiv.org/abs/2503.21591"}}]},{"typeName":"relatedDatasets","multiple":true,"typeClass":"primitive","value":["BGU Pattern-Cutting Dataset (BGU-PatCut): https://doi.org/10.17617/3.JK4AN"]}]}},"files":[{"description":"","label":"3DPrintFiles.zip","restricted":false,"directoryLabel":"Knot Tying","version":1,"datasetVersionId":2186,"dataFile":{"id":327397,"persistentId":"","filename":"3DPrintFiles.zip","contentType":"application/zip","friendlyType":"ZIP Archive","filesize":602181,"description":"","storageIdentifier":"54://edmond-objstor-prod:1990e8dac96-961abcc1904b","rootDataFileId":-1,"md5":"2e00628a42073518e454f2d25e6e5aab","checksum":{"type":"MD5","value":"2e00628a42073518e454f2d25e6e5aab"},"tabularData":false,"creationDate":"2025-09-03","publicationDate":"2025-09-10","directoryLabel":"Knot Tying","lastUpdateTime":"2025-09-10T05:03:55Z","fileAccessRequest":true}},{"description":"","label":"3DPrintFiles.zip","restricted":false,"directoryLabel":"Suturing","version":1,"datasetVersionId":2186,"dataFile":{"id":327411,"persistentId":"","filename":"3DPrintFiles.zip","contentType":"application/zip","friendlyType":"ZIP Archive","filesize":946924,"description":"","storageIdentifier":"54://edmond-objstor-prod:19911107fb2-b677c8b11e7c","rootDataFileId":-1,"md5":"b791ea